# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set to "ollama" for local inference or "groq" for Groq cloud (free tier).
# Only the section matching your chosen provider needs to be filled in.
LLM_PROVIDER=ollama

# ── Ollama (LLM_PROVIDER=ollama) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# ── Groq (LLM_PROVIDER=groq) ──────────────────────────────────────────────────
# Free tier: https://console.groq.com → API Keys → Create
# Recommended model: llama-3.3-70b-versatile (fast, high quality, free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents

# ── Embeddings ────────────────────────────────────────────────────────────────
# FastEmbed model — downloaded automatically on first run (~25 MB)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_TOP_K=8
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

# ── CORS ──────────────────────────────────────────────────────────────────────
# Space-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173 http://localhost:5174 http://localhost

# ── LangFuse observability ────────────────────────────────────────────────────
# Leave blank to disable tracing. After `docker compose up`, visit
# http://localhost:3000 → create account → create project → copy keys here.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440
AUTH_USERNAME=admin
# bcrypt hash of the password. Generate with: make hash-password
# Default hash below = "changeme"
AUTH_PASSWORD_HASH=$2b$12$IO/CRwLA7Lg2.PfR47Drgu2XGNhtKsR1zm0RYaG4sJoDwSzxhA6Zi
